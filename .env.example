# Copy this to each service's .env and fill in values

# Postgres (shared instance, separate DBs per service)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=postgres        # service name inside Docker network
POSTGRES_PORT=5432

# MongoDB
MONGO_USER=mongo
MONGO_PASSWORD=mongo
MONGO_HOST=mongodb
MONGO_PORT=27017

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# JWT (same secret used by all services to verify tokens)
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
